# Gemini API Key (Google AI Studio에서 발급: https://aistudio.google.com/)
# 서버 환경변수로 등록 시 클라이언트 번들에 노출되지 않고 안전하게 백엔드 프록시에서 사용됩니다.
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web App configuration (public client values)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Firebase Admin SDK uses Application Default Credentials.
# Set FIREBASE_ADMIN_PROJECT_ID; locally configure ADC with `gcloud auth application-default login`.
# On production, use the runtime service account with least-privilege permissions.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
# Or set these on a host without Application Default Credentials (keep private key server-only).
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
